# Fit Factory — Automated Sales Agent — environment variables
#
# Copy to .env.local and fill in as integrations go live. With nothing set,
# MARIANA_TEK_MODE defaults to "mock" and the whole pipeline runs against
# realistic seeded roster/membership data — safe to run and iterate on the
# rules engine before the real API key arrives.

# ---------------------------------------------------------------------------
# Mariana Tek
# ---------------------------------------------------------------------------
# "mock" (default) or "real". Switch to "real" once the API key/URL below
# are filled in.
MARIANA_TEK_MODE=mock

# Fit Factory's location/tenant. https://fitfactory.marianatek.com/admin/location/48718
MARIANA_TEK_LOCATION_ID=48718

# Filled in once the partner API request is approved — Mariana Tek sends a
# time-limited secure link with both the API URL and API key.
MARIANA_TEK_API_URL=
MARIANA_TEK_API_KEY=

# ---------------------------------------------------------------------------
# HighLevel — not used yet (v1 only drafts a recap, doesn't send/execute).
# Wire in once we move to actually sending approved messages.
# ---------------------------------------------------------------------------
HIGHLEVEL_MODE=mock
HIGHLEVEL_PRIVATE_TOKEN=
HIGHLEVEL_LOCATION_ID=

# ---------------------------------------------------------------------------
# Recap delivery
# ---------------------------------------------------------------------------
RECAP_EMAIL_TO=lucas@fitfactoryfitness.com
